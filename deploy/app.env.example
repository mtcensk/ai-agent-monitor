# Конфигурация AI-агента мониторинга. Права на сервере: 600 (chmod 600 app.env).
# Реальный app.env лежит только на сервере /app/ai_monitor/app.env — в репозиторий не коммитить!

# Токен Telegram-бота (от @BotFather)
TELEGRAM_TOKEN=123456:REPLACE_ME

# LLM-провайдер (OpenCode Go)
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=oc_sk_REPLACE_ME
LLM_MODEL=gpt-5-nano

# Час отправки ежедневного отчёта (0-23, по времени сервера)
REPORT_HOUR=9

# Grafana (для скриншотов дашбордов в отчётах и по команде /dash)
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_TOKEN=glsa_REPLACE_ME

# Whitelist Telegram user id, которым агент отвечает (через запятую)
TG_ALLOWED_USERS=795594848
