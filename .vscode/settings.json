{
  "python.analysis.extraPaths": ["src"],
  "python.defaultInterpreterPath": "python3",
  "files.associations": {
    "*.sh": "shellscript",
    "app.env*": "dotenv"
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [120]
  },
  "editor.formatOnSave": false,
  "files.eol": "\n",
  "search.exclude": {
    "materials/**": true
  }
}
